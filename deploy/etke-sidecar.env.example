# Replace every example value before starting the sidecar.
# Set this to an existing Docker network that the operator's reverse proxy can reach.
MATRIX_PROXY_NETWORK=replace-with-existing-proxy-network

# Use the canonical homeserver URL reachable from the server and Radicale containers.
MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_SERVER_NAME=example.org

# The API hostname must be served over HTTPS and routed to server:3000.
MATRIX_CALENDAR_API_URL=https://calendar-api.example.org

# The widget hostname must be served over HTTPS and routed to widget:8080.

# Supply this from the operator's secret store when possible. For local Compose,
# put the actual value only in an ignored, mode-600 deploy/.env.local copy.
MATRIX_CALENDAR_BOT_ACCESS_TOKEN=replace-with-secret

# Keep the Matrix widget parameter placeholders literal in the final values.
MATRIX_CALENDAR_WIDGET_URL='https://calendar-widget.example.org/#/?theme=$org.matrix.msc2873.client_theme&matrix_user_id=$matrix_user_id&matrix_display_name=$matrix_display_name&matrix_avatar_url=$matrix_avatar_url&matrix_room_id=$matrix_room_id&matrix_client_id=$org.matrix.msc2873.client_id&matrix_client_language=$org.matrix.msc2873.client_language&matrix_device_id=$org.matrix.msc3819.matrix_device_id&matrix_base_url=$org.matrix.msc4039.matrix_base_url'
MATRIX_CALENDAR_COCKPIT_URL='https://calendar-widget.example.org/cockpit/#/?theme=$org.matrix.msc2873.client_theme&matrix_user_id=$matrix_user_id&matrix_display_name=$matrix_display_name&matrix_avatar_url=$matrix_avatar_url&matrix_room_id=$matrix_room_id&matrix_client_id=$org.matrix.msc2873.client_id&matrix_client_language=$org.matrix.msc2873.client_language&matrix_device_id=$org.matrix.msc3819.matrix_device_id&matrix_base_url=$org.matrix.msc4039.matrix_base_url'
MATRIX_CALENDAR_BREAKOUT_URL='https://calendar-widget.example.org/#/?theme=$org.matrix.msc2873.client_theme&matrix_user_id=$matrix_user_id&matrix_display_name=$matrix_display_name&matrix_avatar_url=$matrix_avatar_url&matrix_room_id=$matrix_room_id&matrix_client_id=$org.matrix.msc2873.client_id&matrix_client_language=$org.matrix.msc2873.client_language&matrix_device_id=$org.matrix.msc3819.matrix_device_id&matrix_base_url=$org.matrix.msc4039.matrix_base_url'

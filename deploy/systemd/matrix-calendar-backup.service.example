# Example only. Review host paths, credentials, permissions, and Docker access
# before copying this file to a systemd unit directory.
[Unit]
Description=Cold backup of the Matrix Calendar sidecar
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=matrix-calendar-backup
Group=matrix-calendar-backup
SupplementaryGroups=docker
UMask=0077
TimeoutStartSec=4h
TimeoutStopSec=5m
KillSignal=SIGTERM
CacheDirectory=matrix-calendar-backup
CacheDirectoryMode=0700
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/backups/matrix-calendar
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

LoadCredential=restic-password:/secure/operator-credentials/restic-password
LoadCredential=s3-credentials:/secure/operator-credentials/s3-credentials
# The coordinator derives these file paths from CREDENTIALS_DIRECTORY and the
# credential IDs above. systemd v249 does not support %d in Environment=.
Environment=RESTIC_CACHE_DIR=/var/cache/matrix-calendar-backup

# With reminderDatabaseEnabled=true and postgresDumpTransport omitted or set
# to "native", configure a password-free libpq service file and load its
# password as a credential:
# LoadCredential=postgres-password:/secure/operator-credentials/postgres-password
# Environment=PGSERVICEFILE=/etc/matrix-calendar/pg_service.conf
# The coordinator does not derive PGPASSFILE from CREDENTIALS_DIRECTORY;
# configure a systemd-compatible explicit path for native PostgreSQL auth.
# The optional "container-exec" transport instead requires a database role
# that can dump over the container's local Unix socket without a password.

ExecStart=/usr/local/sbin/matrix-calendar-cold-backup --config /etc/matrix-calendar/backup.json

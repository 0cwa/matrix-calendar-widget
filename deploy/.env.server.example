# Copy to deploy/.env.server only when enabling the corresponding room or
# reminder feature. Leave optional values absent rather than setting them empty.
# This file is read by the server container and is not used for Compose
# interpolation. Use real, operator-issued credentials; these examples are
# commented so a copied file keeps all optional features disabled.

# One exact room-to-calendar binding for a controlled pilot:
# ROOM_CALENDAR_BINDINGS='[{"roomId":"!replace-this-room-id:example.org","calendarId":"team-calendar"}]'
# ROOM_CALENDAR_ACCESS_ENABLED=true
# ROOM_CALENDAR_EVENT_WRITES_ENABLED=true
# MATRIX_APPLICATION_SERVICE_USER_ID='@_matrix_calendar_service:example.org'
# MATRIX_APPLICATION_SERVICE_TOKEN='replace-with-the-appservice-as-token'

# Optional app-owned PostgreSQL reminder store; verified TLS is the default.
# MATRIX_CALENDAR_REMINDER_DATABASE_URL='postgresql://calendar_app:replace-with-secret@db.example.org:5432/matrix_calendar'
# MATRIX_CALENDAR_REMINDER_DATABASE_TLS_MODE=verify-full
# Optional driver fallback when the database URL omits a port. The preflight
# uses this server value rather than a PGPORT exported in the caller's shell.
# PGPORT=5432
# MATRIX_CALENDAR_REMINDER_CONFIGURATION_ENABLED=true
# ROOM_CALENDAR_REMINDER_DELIVERY_ENABLED=true

# Independent default-off best-effort event action notices.
# ROOM_CALENDAR_ACTION_MESSAGES_ENABLED=true

# Public ICS subscriptions stay off unless both a public origin and a dedicated
# persistent signing key are configured. The gateway origin must be externally
# reachable; configure only GET/HEAD /v1/public-calendar-feeds/<envelope> at
# the proxy and redact that path from proxy access logs. Keep Radicale's native
# token and sharing routes network-private; the signed envelope is not
# encrypted and can be decoded to the native bearer token. Anyone with a
# published link can read that calendar.
# MATRIX_CALENDAR_PUBLIC_FEED_ORIGIN=https://calendar.example.org
# Use exactly one key source. The direct value is 32 random bytes encoded as
# 43 unpadded base64url characters. Do not reuse Matrix/OpenID/CalDAV secrets.
# MATRIX_CALENDAR_PUBLIC_FEED_SIGNING_KEY=<43-character-base64url-secret>
# Alternatively mount this file in the server container and configure:
# MATRIX_CALENDAR_PUBLIC_FEED_SIGNING_KEY_FILE=/run/secrets/public-feed-key

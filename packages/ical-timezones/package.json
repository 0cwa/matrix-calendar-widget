{
  "name": "@matrix-calendar-widget/ical-timezones",
  "description": "Generated IANA VTIMEZONE data and safe lookup for Matrix Calendar Widget",
  "author": "Matrix Calendar Widget contributors",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.0.0",
  "source": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "main": "./lib/index.js",
  "scripts": {
    "docker:build": "echo \"Nothing to build\"",
    "build": "tsc",
    "depcheck": "depcheck",
    "test": "jest --watch",
    "test:all": "jest --coverage --watchAll=false",
    "lint": "eslint . --max-warnings=0",
    "tsc": "tsc --noEmit",
    "translate": "echo \"Nothing to translate\"",
    "generate-disclaimer": "echo \"Nothing to generate\""
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^29.7.0",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.4",
    "ical.js": "^2.2.1",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.0"
  },
  "jest": {
    "testEnvironment": "node",
    "automock": false,
    "preset": "ts-jest",
    "verbose": true,
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "roots": [
      "<rootDir>/src"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0cwa/matrix-calendar-widget.git"
  }

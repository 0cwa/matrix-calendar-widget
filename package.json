{
  "name": "matrix-calendar-widget",
  "private": true,
  "workspaces": [
    "matrix-calendar-widget",
    "matrix-calendar-server",
    "e2e",
    "packages/*"
  ],
  "resolutions": {
    "**/cross-spawn": "^7.0.5",
    "**/cookie": "^0.7.2",
    "**/express": "^4.21.2",
    "**/form-data": "^4.0.4",
    "**/ip": "https://registry.npmjs.org/neoip/-/neoip-2.1.0.tgz",
    "**/micromatch": "^4.0.8",
    "**/nanoid": "^3.3.8",
    "**/nano-css": "^5.6.2",
    "**/nth-check": "^2.1.1",
    "**/postcss": "^8.4.49",
    "**/tough-cookie": "^4.1.3",
    "**/webpack": "^5.97.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "depcheck": "^1.4.7",
    "husky": "^9.0.11",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.7.3",
    "yarn-deduplicate": "^6.0.2"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=1.22.1 <2.0.0"
  },
  "scripts": {
    "start": "yarn workspace @matrix-calendar-widget/widget start",
    "dev": "yarn workspace @matrix-calendar-widget/widget dev",
    "build": "yarn workspaces run build",
    "tsc": "yarn workspaces run tsc",
    "test": "yarn workspace @matrix-calendar-widget/widget test",
    "test:all": "yarn workspaces run test:all",
    "lint": "yarn workspaces run lint",
    "depcheck": "yarn depcheck:root && yarn workspaces run depcheck",
    "depcheck:root": "depcheck --ignores=prettier-plugin-organize-imports,@changesets/cli",
    "deduplicate": "yarn-deduplicate",
    "generate-disclaimer": "yarn workspaces run generate-disclaimer",
    "docker:build": "yarn workspaces run docker:build",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "translate": "yarn workspaces run translate",
    "e2e": "yarn workspace e2e e2e",
    "ci": "yarn prettier:check && yarn depcheck && yarn lint && yarn tsc && yarn test:all && yarn build",
    "dev:services:up": "bash dev/up.sh",
    "dev:services:down": "docker compose -f dev/compose.yaml down",
    "dev:services:reset": "docker compose -f dev/compose.yaml down -v --remove-orphans"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "bash -c \"yarn lint\"",
      "bash -c \"yarn tsc --pretty\"",
      "prettier --write"
    ],
    "*": [
      "bash -c \"yarn depcheck\""
    ],
    "*.{yaml,yml,json,md}": [
      "prettier --write"
    ],
    "*.{json,js,jsx,ts,tsx}": [
      "bash -c \"yarn translate --ci --dry-run\""
    ]
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
